{
    "name": "epubcheck-website",
    "version": "1.0.0",
    "description": "EPUBCheck website",
    "scripts": {
        "clean": "rimraf _site",
        "start": "npm-run-all -s build:gulp -p watch:*",
        "watch:eleventy": "npx @11ty/eleventy --serve",
        "watch:gulp": "npx gulp watch",
        "build": "cross-env NODE_ENV=production run-s clean build:gulp build:eleventy",
        "build:gulp": "npx gulp",
        "build:eleventy": "npx @11ty/eleventy",
        "deploy:gh-pages": "npx gh-pages -b website -d _site",
        "deploy": "run-s clean build deploy:gh-pages",
        "test": "echo run tests"
    },
